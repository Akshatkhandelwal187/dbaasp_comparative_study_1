   "source": [
    "# DBAASP Comparative Study: Multi-Dimensional Feature Analysis\n",
    "\n",
    "## Overview\n",
    "This notebook conducts a comprehensive comparative analysis of antimicrobial peptides across 6 dimensions:\n",
    "- **Origin**: Natural vs Synthetic\n",
    "- **Target Group**: Biological activity (antibacterial, antifungal, etc.)\n",
    "- **Target Object**: Molecular target (Lipid Bilayer, Ribosome, etc.)\n",
    "- **Length Class**: Peptide size categories\n",
    "- **Kingdom**: Evolutionary origin\n",
    "- **Domain**: Taxonomic domain (Archaea, Bacteria, Eukarya)\n",
    "\n",
    "**Goal**: Identify biological patterns and insights by comparing features across dimensions.\n",
    "\n",
    "Dataset: 174,580 peptides × 16 features across 55 CSV files"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup & Data Loading"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "from scipy.stats import chi2_contingency, kruskal, mannwhitneyu\n",
    "import warnings\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set style for visualizations\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (12, 6)\n",
    "plt.rcParams['font.size'] = 10\n",
    "\n",
    "# Define paths\n",
    "data_dir = Path('/home/user/dbaasp_comparative_study_1')\n",
    "dimensions = {\n",
    "    'origin': 'by_origin',\n",
    "    'domain': 'by_domain',\n",
    "    'kingdom': 'by_kingdom',\n",
    "    'length_class': 'by_length_class',\n",
    "    'target_group': 'by_target_group',\n",
    "    'target_object': 'by_target_object'\n",
    "}\n",
    "\n",
    "print(\"Repository structure:\")\n",
    "for dim_name, dir_name in dimensions.items():\n",
    "    dim_path = data_dir / dir_name\n",
    "    if dim_path.exists():\n",
    "        csv_files = list(dim_path.glob('*.csv'))\n",
    "        print(f\"  {dim_name}: {len(csv_files)} files\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load all data and add dimension labels\n",
    "all_data = []\n",
    "dimension_info = {}\n",
    "\n",
    "for dim_name, dir_name in dimensions.items():\n",
    "    dim_path = data_dir / dir_name\n",
    "    csv_files = sorted(dim_path.glob('*.csv'))\n",
    "    \n",
    "    for csv_file in csv_files:\n",
    "        df = pd.read_csv(csv_file)\n",
    "        # Extract category name from filename (remove .csv)\n",
    "        category = csv_file.stem\n",
    "        \n",
    "        # Add dimension and category columns\n",
    "        df['Dimension'] = dim_name\n",
    "        df['Category'] = category\n",
    "        \n",
    "        all_data.append(df)\n",
    "        \n",
    "        if dim_name not in dimension_info:\n",
    "            dimension_info[dim_name] = []\n",
    "        dimension_info[dim_name].append(category)\n",
    "\n",
    "# Combine all data\n",
    "df_complete = pd.concat(all_data, ignore_index=True)\n",
    "\n",
    "print(f\"\\nTotal records loaded: {len(df_complete):,}\")\n",
    "print(f\"Total features: {len(df_complete.columns)}\")\n",
    "print(f\"\\nDimensions and categories:\")\n",
    "for dim, cats in dimension_info.items():\n",
    "    print(f\"  {dim}: {len(cats)} categories - {', '.join(cats[:3])}{'...' if len(cats) > 3 else ''}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data quality check\n",
    "print(\"\\n=== DATA QUALITY REPORT ===\")\n",
    "print(f\"\\nMissing values per column:\")\n",
    "missing = df_complete.isnull().sum()\n",
    "print(missing[missing > 0] if missing.any() else \"No missing values\")\n",
    "\n",
    "print(f\"\\nDuplicate rows: {df_complete.duplicated().sum()}\")\n",
    "\n",
    "print(f\"\\nData types:\")\n",
    "print(df_complete.dtypes)\n",
    "\n",
    "print(f\"\\nBasic statistics for numerical columns:\")\n",
    "print(df_complete.describe())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Phase 1: Univariate Analysis"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.1 Sequence Length Distribution by Dimension"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sequence length statistics by each dimension\n",
    "length_stats = {}\n",
    "\n",
    "print(\"\\n=== SEQUENCE LENGTH STATISTICS BY DIMENSION ===\")\n",
    "for dim in dimensions.keys():\n",
    "    print(f\"\\n{dim.upper()}:\")\n",
    "    stats_by_cat = df_complete.groupby('Category')['Length_of_Sequence'].agg([\n",
    "        ('count', 'count'),\n",
    "        ('mean', 'mean'),\n",
    "        ('median', 'median'),\n",
    "        ('std', 'std'),\n",
    "        ('min', 'min'),\n",
    "        ('max', 'max'),\n",
    "        ('Q1', lambda x: x.quantile(0.25)),\n",
    "        ('Q3', lambda x: x.quantile(0.75))\n",
    "    ])\n",
    "    \n",
    "    # Filter to current dimension\n",
    "    dim_data = df_complete[df_complete['Dimension'] == dim]\n",
    "    stats_by_cat_dim = dim_data.groupby('Category')['Length_of_Sequence'].agg([\n",
    "        ('count', 'count'),\n",
    "        ('mean', 'mean'),\n",
    "        ('median', 'median'),\n",
    "        ('std', 'std'),\n",
    "        ('min', 'min'),\n",
    "        ('max', 'max')\n",
    "    ]).round(2)\n",
    "    \n",
    "    print(stats_by_cat_dim)\n",
    "    length_stats[dim] = stats_by_cat_dim"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize length distributions by key dimensions\n",
    "fig, axes = plt.subplots(2, 3, figsize=(16, 10))\n",
    "\n",
    "for idx, dim in enumerate(dimensions.keys()):\n",
    "    ax = axes[idx // 3, idx % 3]\n",
    "    dim_data = df_complete[df_complete['Dimension'] == dim]\n",
    "    \n",
    "    # Box plot\n",
    "    dim_data.boxplot(column='Length_of_Sequence', by='Category', ax=ax)\n",
    "    ax.set_title(f'Sequence Length Distribution by {dim.replace(\"_\", \" \").title()}')\n",
    "    ax.set_xlabel('Category')\n",
    "    ax.set_ylabel('Sequence Length (aa)')\n",
    "    ax.tick_params(axis='x', rotation=45)\n",
    "    plt.sca(ax)\n",
    "    plt.xticks(rotation=45, ha='right')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"Box plots generated for sequence length by each dimension\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Statistical tests: Kruskal-Wallis for length differences across categories\n",
    "print(\"\\n=== KRUSKAL-WALLIS TEST: Sequence Length Differences Across Dimensions ===\")\n",
    "kruskal_results = {}\n",
    "\n",
    "for dim in dimensions.keys():\n",
    "    dim_data = df_complete[df_complete['Dimension'] == dim]\n",
    "    \n",
    "    # Get groups for each category\n",
    "    groups = [group['Length_of_Sequence'].values for _, group in dim_data.groupby('Category')]\n",
    "    \n",
    "    # Perform Kruskal-Wallis test\n",
    "    h_stat, p_value = kruskal(*groups)\n",
    "    \n",
    "    kruskal_results[dim] = {'H-statistic': h_stat, 'p-value': p_value}\n",
    "    \n",
    "    print(f\"\\n{dim.upper()}:\")\n",
    "    print(f\"  H-statistic: {h_stat:.4f}\")\n",
    "    print(f\"  p-value: {p_value:.4e}\")\n",
    "    print(f\"  Significant: {'YES' if p_value < 0.05 else 'NO'}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.2 Categorical Feature Distributions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
