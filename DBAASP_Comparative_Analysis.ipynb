  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Summary Statistics & Key Findings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
