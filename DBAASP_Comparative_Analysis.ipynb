   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Phase 2: Multi-Dimensional Analysis"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3.1 Cross-Dimension Contingency Tables & Chi-Square Tests"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create comprehensive cross-tabulation: Origin × Target Group\n",
    "print(\"\\n=== ORIGIN × TARGET GROUP CROSS-TABULATION ===\")\n",
    "\n",
    "origin_data = df_complete[df_complete['Dimension'] == 'origin']\n",
    "target_group_data = df_complete[df_complete['Dimension'] == 'target_group']\n",
    "\n",
    "# Create a combined dataframe for this analysis\n",
    "combined_origin_target = pd.merge(\n",
    "    origin_data[['ID', 'Category']].rename(columns={'Category': 'Origin'}),\n",
    "    df_complete[['ID', 'TARGET GROUP']],\n",
    "    on='ID'\n",
    )\n",
    "\n",
    "# Create contingency table\n",
    "contingency_table = pd.crosstab(combined_origin_target['Origin'], combined_origin_target['TARGET GROUP'])\n",
    "print(f\"\\nContingency Table (counts):\")\n",
    "print(contingency_table)\n",
    "\n",
    "# Chi-square test\n",
    "chi2, p_val, dof, expected = chi2_contingency(contingency_table)\n",
    "print(f\"\\nChi-Square Test Results:\")\n",
    "print(f\"  Chi-square statistic: {chi2:.4f}\")\n",
    "print(f\"  P-value: {p_val:.4e}\")\n",
    "print(f\"  Degrees of freedom: {dof}\")\n",
    "print(f\"  Significant: {'YES' if p_val < 0.05 else 'NO'}\")\n",
    "\n",
    "# Cramér's V for effect size\n",
    "n = contingency_table.sum().sum()\n",
    "cramers_v = np.sqrt(chi2 / (n * (min(contingency_table.shape) - 1)))\n",
    "print(f\"  Cramér's V (effect size): {cramers_v:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Heatmap of Origin × Target Group\n",
    "contingency_pct = contingency_table.div(contingency_table.sum(axis=1), axis=0) * 100\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 4))\n",
    "sns.heatmap(contingency_pct, annot=True, fmt='.1f', cmap='YlOrRd', ax=ax, cbar_kws={'label': 'Percentage (%)'})\n",
    "ax.set_title('Origin × Target Group Distribution (%)')\n",
    "ax.set_xlabel('Target Group')\n",
    "ax.set_ylabel('Origin')\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nContingency analysis complete\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Length Class × Target Group Analysis\n",
    "print(\"\\n=== LENGTH CLASS × TARGET GROUP CROSS-TABULATION ===\")\n",
    "\n",
    "# Combine data for length class and target group\n",
    "length_class_data = df_complete[df_complete['Dimension'] == 'length_class']\n",
    "combined_length_target = pd.merge(\n",
    "    length_class_data[['ID', 'Category']].rename(columns={'Category': 'Length_Class'}),\n",
    "    df_complete[['ID', 'TARGET GROUP']],\n",
    "    on='ID'\n",
    ")\n",
    "\n",
    "contingency_length_target = pd.crosstab(combined_length_target['Length_Class'], combined_length_target['TARGET GROUP'])\n",
    "\n",
    "# Chi-square test\n",
    "chi2_lt, p_val_lt, dof_lt, _ = chi2_contingency(contingency_length_target)\n",
    "n_lt = contingency_length_target.sum().sum()\n",
    "cramers_v_lt = np.sqrt(chi2_lt / (n_lt * (min(contingency_length_target.shape) - 1)))\n",
    "\n",
    "print(f\"\\nChi-Square Test Results:\")\n",
    "print(f\"  Chi-square statistic: {chi2_lt:.4f}\")\n",
    "print(f\"  P-value: {p_val_lt:.4e}\")\n",
    "print(f\"  Cramér's V: {cramers_v_lt:.4f}\")\n",
    "print(f\"  Significant: {'YES' if p_val_lt < 0.05 else 'NO'}\")"
   ]
  },
  {
