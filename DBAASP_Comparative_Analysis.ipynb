  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Phase 3: Diversity Analysis & Comparative Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to calculate Shannon diversity index\n",
    "def shannon_diversity(counts):\n",
    "    \"\"\"Calculate Shannon diversity index for a distribution.\"\"\"\n",
    "    proportions = counts / counts.sum()\n",
    "    diversity = -np.sum(proportions * np.log(proportions + 1e-10))\n",
    "    return diversity\n",
    "\n",
    "# Function to calculate Simpson diversity index\n",
    "def simpson_diversity(counts):\n",
    "    \"\"\"Calculate Simpson diversity index for a distribution.\"\"\"\n",
    "    proportions = counts / counts.sum()\n",
    "    diversity = 1 - np.sum(proportions ** 2)\n",
    "    return diversity\n",
    "\n",
    "# Calculate diversity indices for each dimension category\n",
    "print(\"\\n=== DIVERSITY ANALYSIS ===\")\n",
    "diversity_results = {}\n",
    "\n",
    "for dim in dimensions.keys():\n",
    "    print(f\"\\n{dim.upper()}:\")\n",
    "    dim_data = df_complete[df_complete['Dimension'] == dim]\n",
    "    \n",
    "    diversity_metrics = []\n",
    "    for category in dim_data['Category'].unique():\n",
    "        cat_data = dim_data[dim_data['Category'] == category]\n",
    "        \n",
    "        # Count target group diversity within each category\n",
    "        target_counts = cat_data['TARGET GROUP'].value_counts()\n",
    "        \n",
    "        shannon = shannon_diversity(target_counts.values)\n",
    "        simpson = simpson_diversity(target_counts.values)\n",
    "        \n",
    "        diversity_metrics.append({\n",
    "            'Category': category,\n",
    "            'Peptide_Count': len(cat_data),\n",
    "            'Unique_Targets': len(target_counts),\n",
    "            'Shannon_Diversity': shannon,\n",
    "            'Simpson_Diversity': simpson\n",
    "        })\n",
    "    \n",
    "    diversity_df = pd.DataFrame(diversity_metrics).sort_values('Shannon_Diversity', ascending=False)\n",
    "    print(diversity_df.to_string(index=False))\n",
    "    diversity_results[dim] = diversity_df"
   ]
  },
  {
   "cell_type": "markdown",
